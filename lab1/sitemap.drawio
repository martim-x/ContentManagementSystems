        <!-- Уровень 2: содержимое страниц (разделы внутри страницы) -->
        <mxCell id="news-rubrics" value="Рубрики: Политика, Экономика,&#10;Спорт, Культура — внутри страницы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#90a3bf;fontColor=#7f8c8d;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="about-content" value="Редакция, документы,&#10;контакты и форма связи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#90a3bf;fontColor=#7f8c8d;fontSize=11;dashed=1;" vertex="1" parent="1">
