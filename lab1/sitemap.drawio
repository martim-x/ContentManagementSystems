        <mxCell id="city-content" value="Афиша, погода, транспорт,&#10;справочник — внутри страницы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#90a3bf;fontColor=#7f8c8d;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="380" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Рёбра -->
        <mxCell id="e-home-news" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3563e9;endArrow=block;endFill=1;" edge="1" parent="1" source="home" target="news">
          <mxGeometry relative="1" as="geometry" />
