<mxfile host="app.diagrams.net" agent="draw.io" version="24.7.7">
  <diagram id="news-portal-sitemap" name="Карта сайта — Новостной портал">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0" background="#fdfdfd">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Уровень 0: главная страница -->
        <mxCell id="home" value="Главная страница&#10;index.html" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#3563e9;strokeColor=#1d4cbb;fontColor=#ffffff;fontSize=15;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Уровень 1: страницы сайта -->
        <mxCell id="news" value="Новости&#10;news.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#3563e9;fontColor=#1d4cbb;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="about" value="О нас&#10;about.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#3563e9;fontColor=#1d4cbb;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="240" width="220" height="50" as="geometry" />
