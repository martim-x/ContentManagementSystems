        <mxCell id="city" value="Город&#10;city.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eff6;strokeColor=#3563e9;fontColor=#1d4cbb;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="240" width="220" height="50" as="geometry" />
