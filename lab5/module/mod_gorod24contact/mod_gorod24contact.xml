<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_gorod24contact</name>
	<author>Город24</author>
	<creationDate>2026-10-03</creationDate>
	<authorEmail>admin@gorod24.by</authorEmail>
	<authorUrl>https://gorod24.by</authorUrl>
	<version>1.0.0</version>
	<description>LAB5_LANG_MODULE_DESC</description>

	<files>
		<filename module="mod_gorod24contact">mod_gorod24contact.php</filename>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>

	<languages folder="language">
		<language tag="ru-RU">ru-RU/mod_gorod24contact.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="module_tag" type="moduleTag" default="g24contact" validate="moduleTag" />
				<field name="module_position" type="modulePosition" default="sidebar-right" validate="modulePosition" />
				<field name="module_title_lbl" type="modulelabel" default="MOD_GOROD24CONTACT_FIELD_TITLE" />
				<field name="title_lbl" type="text" default="Написать в редакцию" filter="string" />
				<field name="module_email" type="text" default="admin@gorod24.by" label="MOD_GOROD24CONTACT_FIELD_EMAIL" />
				<field name="button_caption" type="text" default="Написать нам" filter="string" />
				<field name="theme_color" type="color" default="#1d4ed8" label="MOD_GOROD24CONTACT_FIELD_COLOR" />
			</fieldset>
		</fields>
	</config>
</extension>
